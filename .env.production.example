# Production Environment Variables for QFlow
# Copy these values into your Render / Railway / Hosting platform dashboard

# 1. MongoDB Atlas connection string (M0 Free Tier)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/qflow?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# 2. Port (usually automatically provided by Render/Railway via $PORT)
PORT=5000

# 3. Secure random string for signing JWT tokens
JWT_SECRET=super_secret_production_key_change_me_12345

# 4. Production environment
NODE_ENV=production

# 5. Production URL (Optional: defaults to the origin of the server)
# CLIENT_URL=https://qflow-demo.onrender.com
